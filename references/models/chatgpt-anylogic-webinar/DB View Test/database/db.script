CREATE SCHEMA PUBLIC AUTHORIZATION DBA
SET SCHEMA PUBLIC
CREATE MEMORY TABLE PUBLIC.AL_CONFIGURATION(PROPERTY_NAME VARCHAR(255) NOT NULL,PROPERTY_VALUE VARCHAR(16777216),UNIQUE(PROPERTY_NAME))
CREATE MEMORY TABLE PUBLIC.AL_GROUPS(GROUP_NAME VARCHAR(255) NOT NULL PRIMARY KEY,DESCRIPTION VARCHAR(16777216))
CREATE MEMORY TABLE PUBLIC.AL_TABLES(TABLE_NAME VARCHAR(255) NOT NULL PRIMARY KEY,GROUP_NAME VARCHAR(255),DESCRIPTION VARCHAR(16777216))
CREATE MEMORY TABLE PUBLIC.AL_CUSTOM_TYPE(TABLE_NAME VARCHAR(255),COLUMN_NAME VARCHAR(255),TYPE VARCHAR(255),NAME VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.AL_VIEWS(VIEW_NAME VARCHAR(255) NOT NULL,VIEW_DEFINITION VARCHAR(16777216),IS_VALID BOOLEAN,UNIQUE(VIEW_NAME))
CREATE MEMORY TABLE PUBLIC.AL_SELECTED_LOG_OBJECTS(NAME VARCHAR(255) NOT NULL,TYPE VARCHAR(255),UNIQUE(NAME))
CREATE MEMORY TABLE PUBLIC.AL_DB_OBJECTS(NAME VARCHAR(255) NOT NULL,TYPE VARCHAR(255),USAGE VARCHAR(255),UNIQUE(NAME))
CREATE MEMORY TABLE PUBLIC.FACTORY(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,LOCATION_ID INTEGER,NAME VARCHAR(16777216),CONSTRAINT "AL_SYSTEM_UQ_344629f3_a0c1_4db6_8f4a_4ce5d5ebe9e1" UNIQUE(NAME))
ALTER TABLE PUBLIC.FACTORY ALTER COLUMN AL_ID RESTART WITH 10
CREATE INDEX "AL_SYSTEM_IDX_993d7f6d_f310_4ce1_b155_b999ffede084" ON PUBLIC.FACTORY(LOCATION_ID)
CREATE INDEX "AL_SYSTEM_IDX_21b187cc_d360_4b32_a349_0ffc1ca63a31" ON PUBLIC.FACTORY(NAME)
CREATE MEMORY TABLE PUBLIC.RETAILER(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,LOCATION_ID INTEGER,NAME VARCHAR(16777216),REQUEST_FROM VARCHAR(16777216),REQUEST_AMOUNT DOUBLE,CONSTRAINT "AL_SYSTEM_FK_40a4ebff_122b_4621_b9c7_db5c47c2373f" FOREIGN KEY(REQUEST_FROM) REFERENCES PUBLIC.FACTORY(NAME) ON DELETE SET NULL ON UPDATE CASCADE)
ALTER TABLE PUBLIC.RETAILER ALTER COLUMN AL_ID RESTART WITH 18
CREATE MEMORY TABLE PUBLIC.EMPLOYEE(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,EMPLOYEE_ID INTEGER,FIRST_NAME VARCHAR(16777216),LAST_NAME VARCHAR(16777216),EMPLOYED_AT INTEGER,POSITION VARCHAR(255))
ALTER TABLE PUBLIC.EMPLOYEE ALTER COLUMN AL_ID RESTART WITH 180
CREATE MEMORY TABLE PUBLIC.LOCATION(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,LOCATION_ID INTEGER,LATITUDE DOUBLE,LONGITUDE DOUBLE,CONSTRAINT "AL_SYSTEM_UQ_3300fef2_0940_4abd_b4ff_5daf8b7ddc83" UNIQUE(LOCATION_ID))
ALTER TABLE PUBLIC.LOCATION ALTER COLUMN AL_ID RESTART WITH 62
CREATE VIEW PUBLIC.FACTORY_INPUT_WRONG (NAME,LATITUDE,LONGITUDE,RECEIVING_COUNT,PRODUCTION_COUNT,MANAGER_COUNT,TOTAL_REQUEST_AMOUNT) AS SELECT F.NAME,L.LATITUDE,L.LONGITUDE,SUM(CASE WHEN E.POSITION='Receiving'THEN 1 ELSE 0 END)AS RECEIVING_COUNT,SUM(CASE WHEN E.POSITION='Production'THEN 1 ELSE 0 END)AS PRODUCTION_COUNT,SUM(CASE WHEN E.POSITION='Manager'THEN 1 ELSE 0 END)AS MANAGER_COUNT,COALESCE(SUM(R.REQUEST_AMOUNT),0)AS TOTAL_REQUEST_AMOUNT FROM PUBLIC.FACTORY F JOIN PUBLIC.LOCATION L ON F.LOCATION_ID=L.LOCATION_ID LEFT JOIN PUBLIC.EMPLOYEE E ON F.LOCATION_ID=E.EMPLOYED_AT LEFT JOIN PUBLIC.RETAILER R ON F.NAME=R.REQUEST_FROM GROUP BY F.NAME,L.LATITUDE,L.LONGITUDE
CREATE VIEW PUBLIC.FACTORY_INPUT (NAME,LATITUDE,LONGITUDE,RECEIVING_COUNT,PRODUCTION_COUNT,MANAGER_COUNT,TOTAL_REQUEST_AMOUNT) AS SELECT F.NAME,L.LATITUDE,L.LONGITUDE,COALESCE(EMP.RECEIVING_COUNT,0)AS RECEIVING_COUNT,COALESCE(EMP.PRODUCTION_COUNT,0)AS PRODUCTION_COUNT,COALESCE(EMP.MANAGER_COUNT,0)AS MANAGER_COUNT,COALESCE(REQ.TOTAL_REQUEST_AMOUNT,0)AS TOTAL_REQUEST_AMOUNT FROM PUBLIC.FACTORY F JOIN PUBLIC.LOCATION L ON F.LOCATION_ID=L.LOCATION_ID LEFT JOIN(SELECT EMPLOYED_AT,COUNT(CASE WHEN POSITION='Receiving'THEN 1 END)AS RECEIVING_COUNT,COUNT(CASE WHEN POSITION='Production'THEN 1 END)AS PRODUCTION_COUNT,COUNT(CASE WHEN POSITION='Manager'THEN 1 END)AS MANAGER_COUNT FROM PUBLIC.EMPLOYEE GROUP BY EMPLOYED_AT)EMP ON F.LOCATION_ID=EMP.EMPLOYED_AT LEFT JOIN(SELECT REQUEST_FROM,SUM(REQUEST_AMOUNT)AS TOTAL_REQUEST_AMOUNT FROM PUBLIC.RETAILER GROUP BY REQUEST_FROM)REQ ON F.NAME=REQ.REQUEST_FROM
ALTER TABLE PUBLIC.FACTORY ADD CONSTRAINT "AL_SYSTEM_FK_085b9121_b71e_4fc0_a2da_d129447fc73a" FOREIGN KEY(LOCATION_ID) REFERENCES PUBLIC.LOCATION(LOCATION_ID) ON DELETE SET NULL ON UPDATE CASCADE
ALTER TABLE PUBLIC.RETAILER ADD CONSTRAINT "AL_SYSTEM_FK_246eaa58_742a_44a1_b2c4_491e6a4e7d84" FOREIGN KEY(LOCATION_ID) REFERENCES PUBLIC.LOCATION(LOCATION_ID) ON DELETE SET NULL ON UPDATE CASCADE
ALTER TABLE PUBLIC.EMPLOYEE ADD CONSTRAINT "AL_SYSTEM_FK_32fa248b_7d11_4fe4_beb1_1f8fd6007b34" FOREIGN KEY(EMPLOYED_AT) REFERENCES PUBLIC.LOCATION(LOCATION_ID) ON DELETE SET NULL ON UPDATE CASCADE
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
