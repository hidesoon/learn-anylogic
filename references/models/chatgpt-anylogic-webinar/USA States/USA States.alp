						<CollectionInitializer Class="CodeValue">
							<Code><![CDATA[{shapeCO, shapeOR, shapeRI, shapeUT, shapeTN, shapeKY, shapeNC, shapeMO, shapeKS, shapeFL, shapeNJ, shapeSD, shapeGA, shapeMN, shapeNM, shapeCT, shapeMI, shapeOK, shapeID, shapeNV, shapeMD, shapeMS, shapeNE, shapeWV, shapeMI2, shapeIA, shapeMT, shapeSC, shapeIL, shapeNH, shapeOH, shapeWY, shapeNY, shapeND, shapeAR, shapeDE, shapeAZ, shapeCA, shapeWA, shapeMA, shapeIN, shapeVT, shapePA, shapeVA, shapeLA, shapeAL, shapeME, shapeWI, shapeTX}]]></Code>
